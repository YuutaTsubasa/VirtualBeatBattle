{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VirtualBeatBattle",
  "version": "0.1.0",
  "identifier": "com.yuuta.virtualbeatbattle",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1424",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "虛擬音鬥樂",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
